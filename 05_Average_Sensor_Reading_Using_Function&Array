#include<stdio.h>
#include<conio.h>

float avg(int a[], int n)
{
    int i, sum=0;
    for(i=0;i<n;i++)
        sum=sum+a[i];
    return (float)sum/n;
}

void main()
{
    int a[5],i;
    clrscr();

    printf("Enter 5 sensor readings:\n");

    for(i=0;i<5;i++)
        scanf("%d",&a[i]);

    printf("Average = %.2f",avg(a,5));

    getch();
}
